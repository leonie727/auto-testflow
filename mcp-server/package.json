{
  "name": "@chaoxing/autotest-flow",
  "version": "0.1.0",
  "private": false,
  "description": "AutoTestFlow — PM 需求读取与自动化测试 AI 工作流（Cursor / Codex）",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "autotest-flow": "bin/autotest-flow.js"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "package-assets",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "start": "node src/index.js",
    "setup": "node scripts/setup.js",
    "setup:codex": "node scripts/setup-codex.js",
    "debug:read-pm-issue": "node scripts/debug-read-pm-issue.js",
    "prepare:package": "node scripts/prepare-package.js",
    "prepack": "npm run prepare:package",
    "doctor": "node bin/autotest-flow.js doctor",
    "test": "node --test test/**/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "http://npm.ans.chaoxing.com/"
  },
  "keywords": [
    "mcp",
    "autotest",
    "playwright",
    "puppeteer",
    "cursor",
    "codex"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "author": "Chaoxing"
}
